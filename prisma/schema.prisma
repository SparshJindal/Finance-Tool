generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts          Account[]
  sessions          Session[]
  holdings          Holding[]
  pushSubscriptions PushSubscription[]
  dailyBriefs       DailyBrief[]

  @@map("users")
}

model Account {
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Holding {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  ticker          String
  company         String
  exchange        String        @default("US")
  sector          String?
  themes          String[]
  thesis          String
  directionLogic  String        @map("direction_logic")
  createdAt       DateTime      @default(now()) @map("created_at")

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions       Question[]
  competitors     Competitor[]
  findings        Finding[]

  @@index([userId])
  @@map("holdings")
}

model Question {
  id        String   @id @default(uuid())
  holdingId String   @map("holding_id")
  category  String
  text      String

  holding   Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  findings  Finding[]

  @@map("questions")
}

model Competitor {
  id        String   @id @default(uuid())
  holdingId String   @map("holding_id")
  name      String
  ticker    String

  holding   Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  @@map("competitors")
}

model Article {
  id          String    @id @default(uuid())
  url         String    @unique
  title       String
  source      String
  publishedAt DateTime  @map("published_at")
  contentHash String    @map("content_hash")
  clusterId   String?   @map("cluster_id")
  firstSeen   DateTime  @default(now()) @map("first_seen")

  findings    Finding[]

  @@index([url])
  @@map("articles")
}

model Finding {
  id          String   @id @default(uuid())
  articleId   String   @map("article_id")
  holdingId   String   @map("holding_id")
  questionId  String?  @map("question_id")
  severity    Int
  summary     String
  delivered   Boolean  @default(false)
  feedback    String?
  createdAt   DateTime @default(now()) @map("created_at")

  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  holding     Holding   @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  question    Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([holdingId])
  @@map("findings")
}

model DailyBrief {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("daily_briefs")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model MarketTicker {
  id        String   @id @default(uuid())
  symbol    String   @unique
  company   String
  exchange  String
  sector    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("market_tickers")
}
