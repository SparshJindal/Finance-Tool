# Vercel Deployment Required Variables

# Database
DATABASE_URL=

# NextAuth / Auth.js (v5)
AUTH_SECRET=
AUTH_URL=
NEXTAUTH_URL=

# AI Providers
# Note: Attaching a PAID Gemini API key removes the 15 RPM quota wall entirely!
# If you are on the free tier, set LLM_PRIMARY=groq to rely on Groq's generous rate limits for high-volume calls.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_PRIMARY=groq
FINNHUB_API_KEY=
MARKETAUX_API_KEY=
RESEND_API_KEY=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Pipeline Configuration
DIGEST_EMAIL=
RELEVANCE_THRESHOLD=0.7
EMBEDDING_MODEL=gemini-embedding-001
GDELT_DELAY_MS=5000

# Tavily Web Search API (primary news source)
# Get a free key at https://tavily.com — provides Google-grade article coverage
# IMPORTANT: Also add TAVILY_API_KEY to Vercel project env (Production) and redeploy
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=10    # Max results per query (default: 10)
TAVILY_NEWS_DAYS=3       # Recency filter: 1=day, 7=week (default: 3 → week)
TAVILY_DAILY_CAP=500     # Daily API call cap; free tier allows ~1000 (default: 500)

# News Fetching & Caching
NEWS_CACHE_TTL_HOURS=12
MARKETAUX_SYMBOLS_PER_REQUEST=3
MARKETAUX_DAILY_CAP=90
NEWS_PROVIDERS=tavily,gdelt,finnhub,marketaux # Comma-separated; tavily runs first, rest are fallback
NEWS_MOCK=false # Set to true to use local mock data instead of calling APIs

# Cron Security
# Vercel Cron will send this secret in the Authorization: Bearer header.
# Generate a random string (e.g. openssl rand -base64 32) and set it here and in Vercel.
CRON_SECRET=
BATCH_SIZE=5

