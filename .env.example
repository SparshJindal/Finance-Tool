DATABASE_URL="postgresql://user:password@host/dbname"
GEMINI_API_KEY="your_gemini_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"
FINNHUB_API_KEY="your_finnhub_api_key_here"
MARKETAUX_API_KEY="your_marketaux_api_key_here"
RESEND_API_KEY="your_resend_api_key_here"
VAPID_PUBLIC_KEY="your_vapid_public_key_here"
VAPID_PRIVATE_KEY="your_vapid_private_key_here"
DIGEST_EMAIL="your_email@example.com"
RELEVANCE_THRESHOLD="0.40"
EMBEDDING_MODEL="gemini-embedding-001"
GDELT_DELAY_MS="5000"
CRON_SECRET="your_cron_secret_here"
AUTH_SECRET="your_auth_secret_here"
MAX_ARTICLES_PER_RUN="150"
RELEVANCE_TOP_K="8"
PUSH_ANSWER_CONFIDENCE="70"
PUSH_MIN_SEVERITY="3"
# Tavily Web Search API (primary news source — get a free key at https://tavily.com)
# IMPORTANT: Also add TAVILY_API_KEY to Vercel project env (Production) and redeploy
TAVILY_API_KEY="your_tavily_api_key_here"
TAVILY_MAX_RESULTS="10"
TAVILY_NEWS_DAYS="3"
TAVILY_DAILY_CAP="500"
NEWS_PROVIDERS="tavily,gdelt,finnhub,marketaux"
LLM_PRIMARY="groq"
OPENROUTER_API_KEY="your_openrouter_api_key_here"
